<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened Runtime: allow microphone capture. Not sandboxed: posting key events and reading
       other apps via Accessibility is impossible inside the App Sandbox (PLAN.md §6). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
